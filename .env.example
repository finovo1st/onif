# ==============================================================================
# FINOVO ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to '.env' and adjust the values according to your environment.
# DO NOT commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# DJANGO CORE SETTINGS
# ------------------------------------------------------------------------------
# Django settings module to load:
# - 'config.settings.development' for local development
# - 'config.settings.production' for production deployments
APP_NAME="Finovo"
DJANGO_SETTINGS_MODULE=config.settings.development

# Debug mode: True for development, False for production
DEBUG=True

# Django Secret Key (generate a strong, unique secret key for production)
# e.g., run: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=django-insecure-change-this-to-a-secure-random-secret-key-in-production

# Comma-separated list of host/domain names that this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1,backend,finovo.app,www.finovo.app

# Comma-separated list of origins authorized to make cross-site HTTP requests
CORS_ALLOWED_ORIGINS=https://finovo.app,https://www.finovo.app,http://localhost:8080

# Comma-separated list of trusted origins for CSRF protection (Mandatory for Django 4+ on HTTPS)
CSRF_TRUSTED_ORIGINS=https://finovo.app,https://www.finovo.app

# Security settings (Set to True in production with valid SSL/HTTPS certificate)
SECURE_SSL_REDIRECT=True



# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Full database connection URL
# Development SQLite default: sqlite:///db.sqlite3
# Production PostgreSQL example: postgres://postgres:postgres@db:5432/investment_db
DATABASE_URL=postgres://postgres:postgres@db:5432/investment_db

# PostgreSQL standalone credentials (used by Docker Compose & DB containers)
POSTGRES_DB=investment_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432


# ------------------------------------------------------------------------------
# CELERY & REDIS CONFIGURATION
# ------------------------------------------------------------------------------
# Redis connection URLs for Celery task broker and results backend
# Local standalone: redis://127.0.0.1:6379/0
# Docker Compose: redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0


# ------------------------------------------------------------------------------
# EMAIL & SMTP CONFIGURATION
# ------------------------------------------------------------------------------
# Email backend:
# - 'django.core.mail.backends.console.EmailBackend' (prints OTP & emails to console/logs)
# - 'django.core.mail.backends.smtp.EmailBackend' (sends real emails via SMTP)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP Server details (e.g., Gmail, SendGrid, Mailgun, AWS SES)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=FINOVO <noreply@finovo.com>


# ------------------------------------------------------------------------------
# INITIAL SUPERUSER / ADMIN SETUP (Used by Docker automated entrypoint)
# ------------------------------------------------------------------------------
# WARNING: Change this password to a strong secret in production!
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@finovo.com
DJANGO_SUPERUSER_PASSWORD=CHANGE_THIS_TO_A_SECURE_PASSWORD

